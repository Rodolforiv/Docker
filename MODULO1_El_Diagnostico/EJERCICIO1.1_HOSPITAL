comandos en limpio :
# Lanza 3 pacientes: dos vivos, uno muerto
docker run -d --name paciente_estable nginx:alpine
docker run -d --name paciente_critico alpine sleep 300
docker run --name paciente_fallecido alpine false
# 1. Solo los vivos
docker ps
# 2. Todos (vivos y muertos). CRUCIAL para ver contenedores que >
docker ps -a
# 3. Solo los IDs de los muertos (para limpieza quirúrgica)
docker ps -aq --filter "status=exited"

Lección: docker ps -a es tu comando de autopsia. false ejecutó y>





